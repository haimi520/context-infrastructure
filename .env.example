# ============================================================
# .env.example — 所有需要的环境变量
# 复制为 .env 并填写你自己的值
# ============================================================

# 邮件发送（tools/send_email_to_myself.py，通用 SMTP：自有邮件网关 / QQ / 163）
# SMTP_SSL=yes 时走 465之类的 SSL 端口；不设则 587 STARTTLS
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# OpenCode Server（用于 observer / reflector / newsletter / crontab_monitor）
# v2 后台服务由 run_with_env.sh 动态解析端口与凭证，此变量是手动运行的兜底
OPENCODE_API_URL=

# Google Analytics 4（用于 ga4_metrics.py）
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Kit / ConvertKit（用于 kit_metrics.py 和 newsletter 发布）
KIT_API_KEY=

# Typefully posting（用于 typefully_post.py）
TYPEFULLY_API_KEY=
TYPEFULLY_SOCIAL_SET_ID=12345

# Typefully metrics（用于 typefully_metrics.py，需从浏览器抓取）
TYPEFULLY_AUTHORIZATION=
TYPEFULLY_ACCOUNT=
TYPEFULLY_SESSION=

# Gemini（用于图片生成）
GEMINI_API_KEY=

# 可选：Google 兼容变量（用于 Gemini）
GOOGLE_API_KEY=

# 图片生成模型覆盖（可选）
IMAGE_GENERATION_MODEL=
GEMINI_FLASH_IMAGE_MODEL=
GEMINI_PRO_IMAGE_MODEL=
GEMINI_IMAGE_GENERATION_MODEL=
GEMINI_IMAGE_UPSCALE_MODEL=
OPENAI_IMAGE_MODEL=

# OpenAI（用于 semantic_search 本地 embedding；SiliconFlow 场景用下面两项）
OPENAI_API_KEY=

# Semantic Search embedding 端点（tools/semantic_search）
# SiliconFlow 免费档：BAAI/bge-m3（需在 siliconflow.cn 注册拿 key 并实名）
SEMANTIC_EMBEDDING_ENDPOINT=https://api.siliconflow.cn/v1
SEMANTIC_EMBEDDING_MODEL=BAAI/bge-m3
SEMANTIC_EMBEDDING_API_KEY=

# 其他模型商（llm 池候选）
OPENDOOR_API_KEY=
WUCUR_API_KEY=
